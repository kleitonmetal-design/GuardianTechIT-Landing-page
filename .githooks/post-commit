#!/usr/bin/env bash

# Alinha nome/e-mail de autor e committer do commit com a origem detectada
# no prefixo da mensagem ([claude] / [antigravity]), definido pelo hook
# prepare-commit-msg que roda antes deste.
#
# Um hook não consegue mudar o autor do commit que já está sendo criado
# (variáveis de ambiente exportadas aqui não voltam para o processo pai do
# `git commit`), então a correção é feita depois: reescreve só os metadados
# de autoria com `git commit --amend --reset-author`.
#
# --reset-author é obrigatório: sem ele, `--amend` mantém o autor original
# do commit e só GIT_COMMITTER_* tem efeito — GIT_AUTHOR_* é ignorado
# silenciosamente, e a condição de parada abaixo nunca fica verdadeira
# (causa loop infinito: cada amend dispara post-commit de novo).
#
# --no-verify evita repetir pre-commit/commit-msg no amend. GITHOOKS_LOCK é
# uma trava de reentrância: o amend também aciona post-commit, e a trava
# garante que essa segunda passada saia imediatamente, sem depender só da
# checagem de autor já correto (defesa em profundidade contra loop).

set -euo pipefail

if [ -n "${GITHOOKS_POST_COMMIT_LOCK:-}" ]; then
    exit 0
fi

MSG=$(git log -1 --pretty=%B 2>/dev/null || echo "")
CUR_NAME=$(git log -1 --pretty=%an 2>/dev/null || echo "")
CUR_EMAIL=$(git log -1 --pretty=%ae 2>/dev/null || echo "")

TARGET_NAME=""
TARGET_EMAIL=""

if echo "$MSG" | grep -qE '^\[antigravity\]'; then
    TARGET_NAME="Antigravity IDE"
    TARGET_EMAIL="antigravity-ide@guardiantechit.com.br"
elif echo "$MSG" | grep -qE '^\[claude\]'; then
    TARGET_NAME="Claude"
    TARGET_EMAIL="noreply@anthropic.com"
fi

if [ -n "$TARGET_NAME" ] && { [ "$CUR_NAME" != "$TARGET_NAME" ] || [ "$CUR_EMAIL" != "$TARGET_EMAIL" ]; }; then
    GITHOOKS_POST_COMMIT_LOCK=1 \
    GIT_AUTHOR_NAME="$TARGET_NAME" GIT_AUTHOR_EMAIL="$TARGET_EMAIL" \
    GIT_COMMITTER_NAME="$TARGET_NAME" GIT_COMMITTER_EMAIL="$TARGET_EMAIL" \
    git commit --amend --no-edit --no-verify --reset-author >/dev/null 2>&1
fi

exit 0
